# Production settings for Tequity.wiki. Copy to `.env.production` (or run `./deploy.sh init`, which also
# generates the secrets below), fill in every value marked REQUIRED, then run `./deploy.sh`.
# Never commit `.env.production`. Full guide: DEPLOY.md.
#
# Rules for values: no spaces around `=`; wrap a value in double quotes if it has spaces or `<` `>`.
# Passwords and secrets: letters and digits only (`openssl rand -hex 24` is perfect).

# ── 1. Where the site lives ─────────────────────────────────────────────────
# REQUIRED. The public address people type in the browser, with https://, no trailing slash.
#   https://wiki.company.com   automatic HTTPS (needs ports 80 + 443 open and the DNS name pointing here)
#   http://203.0.113.10        plain HTTP by IP address, for a quick test only (Google sign-in will refuse it)
PORTAL_ORIGIN=

# Optional. Leave empty in almost every case: the web server derives it from PORTAL_ORIGIN.
# Set it to ":80" only when something in front (a cloud load balancer) already provides HTTPS.
PORTAL_DOMAIN=

# Optional. Host port for plain HTTP (default 80). Change only if 80 is taken by something else.
HTTP_PORT=80

# ── 2. Database and queue (created by this stack; nothing to install) ───────
# REQUIRED. Two passwords for the bundled PostgreSQL. `./deploy.sh init` generates both.
POSTGRES_PASSWORD=
APP_DB_PASSWORD=

# ── 3. Sign-in ──────────────────────────────────────────────────────────────
# REQUIRED. Google OAuth client of type "Internal" (Google Cloud console, APIs & Services, Credentials).
# Authorized redirect URI to register:  <PORTAL_ORIGIN>/api/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# REQUIRED. Only accounts on this email domain can sign in, e.g. tequity.tech
ALLOWED_EMAIL_DOMAIN=
# REQUIRED. Signs the sign-in cookie, 32+ characters. `./deploy.sh init` generates it.
COOKIE_SECRET=

# ── 4. The first admin (REQUIRED: fill in at least one of the two options) ─
# Option A, email + password: the deploy creates this admin and sets the password the FIRST time only.
# Afterwards the admin can change it in the app (Admin > Settings). Delete ADMIN_PASSWORD from this
# file once you have signed in. Password: 12+ characters.
ADMIN_EMAIL=
ADMIN_PASSWORD=
# Option B, Google only: comma-separated emails that become admin the first time they sign in with Google.
INITIAL_ADMIN_EMAILS=

# ── 5. Optional features (the site works without them) ──────────────────────
# AI scoring of written answers. Empty: answers stay "Being scored" until a key is added.
ANTHROPIC_API_KEY=
LLM_SCORING_MODEL=claude-haiku-5-5
# Manager emails for red flags. Needs a sender address on a domain verified in Resend. Empty: no emails.
RESEND_API_KEY=
EMAIL_FROM=
