# apps/api/.env — used by the API, the worker, Prisma and scripts. Copy to .env; never commit real values.
# Production values come from the host's environment variables. All are validated at start-up (src/config/env.ts).

NODE_ENV=development
PORT=4101
WORKER_HEALTH_PORT=4102
# Public URL of the portal: CSRF Origin check, Google redirect URI base, links in emails.
PORTAL_ORIGIN=http://localhost:4100
# Behind Caddy (or any proxy) set to the number of proxy hops, e.g. 1. Locally: false.
TRUST_PROXY=false
LOG_LEVEL=info

# --- Database (PostgreSQL 18) ---
# Runtime: the restricted app role (no BYPASSRLS). The app never connects as postgres.
DATABASE_URL=postgresql://app_user:<APP_DB_PASSWORD>@127.0.0.1:4132/portal
# Migrations and setup scripts only: the owner role.
DIRECT_URL=postgresql://postgres:<POSTGRES_PASSWORD>@127.0.0.1:4132/portal
# Password `pnpm db:migrate` gives the app_user role.
APP_DB_PASSWORD=
# Comma-separated emails that become admin on their FIRST sign-in (loaded by `pnpm db:migrate`).
INITIAL_ADMIN_EMAILS=
# First admin with email + password sign-in: set both, run `pnpm db:migrate`, then remove ADMIN_PASSWORD.
ADMIN_EMAIL=
ADMIN_PASSWORD=

# --- Redis (BullMQ) ---
REDIS_URL=redis://127.0.0.1:4179

# --- Google sign-in (OAuth client of type "Internal" in the company Workspace) ---
# Redirect URI to register: <PORTAL_ORIGIN>/api/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
ALLOWED_EMAIL_DOMAIN=company.com
# Signs the short-lived sign-in state cookie. Generate with: openssl rand -base64 32
COOKIE_SECRET=
# Local development only: "sign in as test user". Always ignored when NODE_ENV=production.
DEV_LOGIN_ENABLED=false

# --- LLM (from M2): AI scoring of written answers, called by the worker only ---
# Empty key: a fake, deterministic scorer in development; in production, answers stay "pending".
ANTHROPIC_API_KEY=
# The Anthropic model that scores answers. Run the calibration set before changing it (PORTAL_PLAN §7.1).
LLM_SCORING_MODEL=claude-haiku-5-5

# --- Email (from M6): managers only, a check-in coming due and a new red flag; sent by the worker ---
# Both empty: a fake that only logs in development; in production, emails stay "pending" until set.
RESEND_API_KEY=
# The sender, on a domain verified in Resend, e.g. Tequity.wiki <wiki@company.com>
EMAIL_FROM=
