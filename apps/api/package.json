{
  "name": "@portal/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "NestJS API (main.ts) and BullMQ worker (worker.ts). The only code that connects to Postgres.",
  "scripts": {
    "build": "prisma generate && tsc -p tsconfig.build.json",
    "dev": "tsx scripts/dev.ts",
    "start": "node --enable-source-maps dist/main.js",
    "start:worker": "node --enable-source-maps dist/worker.js",
    "typecheck": "prisma generate && tsc -p tsconfig.json --noEmit",
    "lint": "eslint .",
    "test": "vitest run --project unit",
    "test:db": "vitest run --project db",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate deploy && tsx scripts/db-setup-app-role.ts && tsx scripts/admin-password.ts --if-missing",
    "admin:set-password": "tsx scripts/admin-password.ts",
    "db:migrate:dev": "prisma migrate dev",
    "db:seed": "tsx scripts/seed.ts",
    "db:seed:demo": "tsx scripts/seed-demo.ts",
    "db:studio": "prisma studio --port 4155",
    "content:import": "tsx scripts/content-import.ts"
  },
  "dependencies": {
    "@ai-sdk/anthropic": "4.0.80",
    "@nestjs/bullmq": "12.0.0",
    "@nestjs/common": "12.1.2",
    "@nestjs/core": "12.1.2",
    "@nestjs/platform-express": "12.1.2",
    "@nestjs/terminus": "12.1.0",
    "@nestjs/throttler": "6.7.1",
    "@portal/content": "workspace:*",
    "@portal/contracts": "workspace:*",
    "@prisma/adapter-pg": "7.10.0",
    "@prisma/client": "7.10.0",
    "ai": "7.0.130",
    "bullmq": "6.3.11",
    "cookie-parser": "1.4.7",
    "helmet": "8.3.0",
    "ioredis": "6.0.0",
    "nestjs-pino": "5.3.1",
    "openid-client": "6.8.8",
    "pg": "8.23.1",
    "pino": "10.4.0",
    "pino-http": "11.0.0",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@nestjs/testing": "12.1.2",
    "@portal/config": "workspace:*",
    "@swc/core": "1.16.13",
    "@types/cookie-parser": "1.4.10",
    "@types/express": "5.0.6",
    "@types/node": "24.19.1",
    "@types/pg": "8.23.1",
    "@types/supertest": "7.2.1",
    "eslint": "10.12.0",
    "prisma": "7.10.0",
    "supertest": "7.3.1",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "unplugin-swc": "2.0.0",
    "vitest": "5.0.3"
  }
}
