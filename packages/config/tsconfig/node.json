{
  "$schema": "https://json.schemastore.org/tsconfig",
  "//": "NestJS API and worker: ESM on Node 24, decorators with metadata for dependency injection.",
  "extends": "./base.json",
  "compilerOptions": {
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "experimentalDecorators": true,
    "emitDecoratorMetadata": true,
    "sourceMap": true,
    "types": ["node"]
  }
}
